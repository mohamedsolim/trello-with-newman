  "item": [
    {
      "name": "create board",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "pm.collectionVariables.set(\"TRELLO_BOARD_NAME\", \"board \" + parseInt(Math.random()*1000));\r",
              "\r",
              "\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "const jsondata = pm.response.json() ;\r",
              "\r",
              "pm.test(\"check board has an id\", function () {\r",
              "    pm.expect(jsondata.id).is.not.oneOf([null , undefined]);\r",
              "});\r",
              "\r",
              "pm.test(\"check board has specified name\", function () {\r",
              "    pm.expect(jsondata.name).to.eql(pm.collectionVariables.get(\"TRELLO_BOARD_NAME\"));\r",
              "});\r",
              "\r",
              "pm.test(\"check board has specified desc\", function () {\r",
              "    pm.expect(jsondata.desc).to.eql(\"this a board created by postman for testing the trello APIS\");\r",
              "});\r",
              "\r",
              "\r",
              "pm.collectionVariables.set(\"TRELLO_BOARD_ID\", jsondata.id);\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
